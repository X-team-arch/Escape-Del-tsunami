function CreateHackerMenu()
    local MainTab = Window:CreateTab("🌊 Survival", 4483362458)

    -- God Mode
    MainTab:CreateToggle({
        Name = "God Mode (Inmortal)",
        CurrentValue = false,
        Callback = function(v) 
            GodModeActive = v
            if v then
                spawn(function()
                    while GodModeActive do
                        local h = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
                        if h then h.Health = math.huge; h.MaxHealth = math.huge end
                        task.wait(0.5)
                    end
                end)
            end
        end,
    })

    -- Anti-Tsunami (Remove/Freeze)
    MainTab:CreateToggle({
        Name = "Remove/Freeze Tsunami + Anti-Wave",
        CurrentValue = false,
        Callback = function(v)
            AntiTsunamiActive = v
            if v then
                spawn(function()
                    while AntiTsunamiActive do
                        for _, part in pairs(workspace:GetDescendants()) do
                            local n = part.Name:lower()
                            if n:find("wave") or n:find("tsunami") or n:find("water") or n:find("flood") then
                                if part:IsA("BasePart") then
                                    part.Transparency = 1
                                    part.CanCollide = false
                                    part.Velocity = Vector3.new(0,0,0)
                                    part.Anchored = true
                                end
                            end
                        end
                        task.wait(1)
                    end
                end)
            end
        end,
    })

    -- Auto Farm Brainrots
    MainTab:CreateToggle({
        Name = "Auto Farm Brainrots + Collect",
        CurrentValue = false,
        Callback = function(v) AutoFarmActive = v; if v then AutoFarmBrainrots() end end,
    })

    -- Auto Mythical etc.
    MainTab:CreateToggle({
        Name = "Auto Mythical / Secret / Divine / Infinity",
        CurrentValue = false,
        Callback = function(v) AutoMythicalActive = v; if v then AutoRareBrainrots() end end,
    })

    -- Spawner
    MainTab:CreateSection("Spawner OP")
    local RarityDropdown = MainTab:CreateDropdown({
        Name = "Elige Rareza para Spawnear",
        Options = {"Common", "Rare", "Legendary", "Mythical", "Divine", "Celestial", "Infinite"},
        CurrentOption = "Mythical",
        Callback = function(opt) SelectedRarity = opt end,
    })

    MainTab:CreateToggle({
        Name = "Auto Spawn Selected Rarity (Infinite)",
        CurrentValue = false,
        Callback = function(v)
            AutoSpawnerActive = v
            if v then
                spawn(function()
                    while AutoSpawnerActive do
                        local rs = game:GetService("ReplicatedStorage")
                        if rs:FindFirstChild("SpawnBrainrot") then
                            rs.SpawnBrainrot:FireServer(SelectedRarity)
                        else
                            Rayfield:Notify({Title = "Spawner", Content = "Remote de spawn no encontrado - ajusta manual", Duration = 5})
                        end
                        task.wait(0.5)
                    end
                end)
            end
        end,
    })

    -- Otras tabs (Exploits, Visual) — las dejé igual
    local ExploitTab = Window:CreateTab("⚡ Exploits Extra", 4483362458)
    ExploitTab:CreateToggle({
        Name = "Delete VIP Walls / Barriers",
        CurrentValue = false,
        Callback = function(v)
            if v then
                for _, wall in pairs(workspace:GetDescendants()) do
                    if wall.Name:lower():find("vip") or wall.Name:lower():find("barrier") or wall.Name:lower():find("wall") then
                        wall:Destroy()
                    end
                end
            end
        end,
    })

    ExploitTab:CreateButton({
        Name = "Infinite Cash / Tokens",
        Callback = function()
            local player = game.Players.LocalPlayer
            if player.leaderstats then
                for _, stat in pairs(player.leaderstats:GetChildren()) do
                    if stat.Name:lower():find("cash") or stat.Name:lower():find("token") or stat.Name:lower():find("money") then
                        stat.Value = math.huge
                    end
                end
            end
        end,
    })

    local VisualTab = Window:CreateTab("👁️ Visual", 4483362458)
    VisualTab:CreateToggle({
        Name = "ESP Raros (Mythical+)",
        CurrentValue = false,
        Callback = function(v) if v then EnableRareESP() else DisableESP() end end,
    })

    Rayfield:Notify({Title = "¡Listo!", Content = "Menú cargado. Usa Get Key para unirte rápido a la comunidad.", Duration = 5})
end

