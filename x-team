    MainTab:CreateSection("Funciones OP")
    
    MainTab:CreateToggle({
        Name = "God Mode (Inmortal)",
        CurrentValue = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        local char = game.Players.LocalPlayer.Character
                        if char and char:FindFirstChild("Humanoid") then
                            char.Humanoid.Health = math.huge
                            char.Humanoid.MaxHealth = math.huge
                        end
                        task.wait(0.5)
                    end
                end)
            end
        end,
    })
    
    -- Agrega aquí los demás toggles, sliders, spawner, etc. que tenías antes
    
    Rayfield:Notify({
        Title = "¡Menú cargado!",
        Content = "Disfruta las funciones OP 🌊💀",
        Duration = 4
    })
end

