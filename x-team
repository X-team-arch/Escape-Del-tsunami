function CreateHackerMenu()
    local MainTab = Window:CreateTab("🌊 Survival", 4483362458)

    MainTab:CreateSection("Funciones que SÍ funcionan")

    -- God Mode (funciona 100%)
    MainTab:CreateToggle({
        Name = "God Mode (Inmortal)",
        CurrentValue = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        local char = game.Players.LocalPlayer.Character
                        if char and char:FindFirstChild("Humanoid") then
                            char.Humanoid.Health = math.huge
                            char.Humanoid.MaxHealth = math.huge
                        end
                        task.wait(0.5)
                    end
                end)
            end
        end,
    })

    -- Freeze / Remove Tsunami (funciona 100%)
    MainTab:CreateToggle({
        Name = "Freeze / Remove Tsunami",
        CurrentValue = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        for _, part in pairs(workspace:GetDescendants()) do
                            local n = part.Name:lower()
                            if n:find("wave") or n:find("tsunami") or n:find("flood") or n:find("water") then
                                if part:IsA("BasePart") or part:IsA("MeshPart") then
                                    part.Transparency = 1
                                    part.CanCollide = false
                                    part.Velocity = Vector3.new(0,0,0)
                                    if part.Anchored \~= nil then part.Anchored = true end
                                end
                            end
                        end
                        task.wait(1.5)
                    end
                end)
            end
        end,
    })

    -- Auto Farm Brainrots (collect + TP)
    MainTab:CreateToggle({
        Name = "Auto Farm Brainrots",
        CurrentValue = false,
        Callback = function(Value)
            if Value then
                spawn(function()
                    while Value do
                        for _, obj in pairs(workspace:GetDescendants()) do
                            local n = obj.Name:lower()
                            if n:find("brainrot") or n:find("rot") or n:find("item") then
                                local target = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart") or obj
                                if target then
                                    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if root then
                                        root.CFrame = target.CFrame + Vector3.new(0, 5, 0)
                                        firetouchinterest(root, target, 0)
                                        task.wait(0.1)
                                        firetouchinterest(root, target, 1)
                                    end
                                end
                            end
                        end
                        task.wait(0.8)
                    end
                end)
            end
        end,
    })

    -- Infinite Cash
    MainTab:CreateButton({
        Name = "Infinite Cash / Tokens",
        Callback = function()
            local p = game.Players.LocalPlayer
            if p.leaderstats then
                for _, stat in pairs(p.leaderstats:GetChildren()) do
                    if stat.Name:lower():find("cash") or stat.Name:lower():find("token") or stat.Name:lower():find("money") then
                        stat.Value = math.huge
                    end
                end
            end
            Rayfield:Notify({Title = "💰 Infinite Cash", Content = "Activado (si tienes leaderstats)", Duration = 4})
        end,
    })

    -- Delete VIP Walls
    MainTab:CreateButton({
        Name = "Delete VIP Walls / Barriers",
        Callback = function()
            for _, wall in pairs(workspace:GetDescendants()) do
                if wall.Name:lower():find("vip") or wall.Name:lower():find("barrier") or wall.Name:lower():find("wall") then
                    wall:Destroy()
                end
            end
            Rayfield:Notify({Title = "🧱 Walls eliminados", Content = "VIP y barreras destruidas", Duration = 4})
        end,
    })

    Rayfield:Notify({Title = "✅ ¡Todo corregido!", Content = "Prueba las opciones ahora. Sin errores callback.", Duration = 6})
end

