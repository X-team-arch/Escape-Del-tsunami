function AutoRareBrainrots()
    spawn(function()
        while AutoMythicalActive do
            for _, obj in pairs(workspace:GetDescendants()) do
                local n = obj.Name:lower()
                if n:find("mythical") or n:find("secret") or n:find("divine") or n:find("celestial") or n:find("infinity") then
                    local target = obj:FindFirstChild("Handle") or obj
                    if target then
                        local root = game.Players.LocalPlayer.Character.HumanoidRootPart
                        root.CFrame = target.CFrame + Vector3.new(0,5,0)
                        firetouchinterest(root, target, 0) task.wait(0.1) firetouchinterest(root, target, 1)
                    end
                end
            end
            task.wait(1)
        end
    end)
end

function EnableRareESP()
    for _, obj in pairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("mythical") or n:find("divine") or n:find("celestial") or n:find("infinity") then
            local hl = Instance.new("Highlight", obj)
            hl.FillColor = Color3.fromRGB(255, 215, 0)  -- Dorado para raros
            hl.OutlineColor = Color3.new(1,0,0)
            hl.FillTransparency = 0.3
        end
    end
end

function DisableESP()
    for _, hl in pairs(workspace:GetDescendants()) do if hl:IsA("Highlight") then hl:Destroy() end end
end

